# Игнорируем локальные данные, но оставляем фото каталога в git.
# Родительские папки нужно открывать по очереди, иначе Git не увидит файлы внутри.
data/*
!data/catalog/
data/catalog/*
!data/catalog/.gitkeep
!data/catalog/images/
!data/catalog/images/**
!output/.gitkeep
